# Copy to backend.hcl and pass to:
#   terraform init -backend-config=backend.hcl
#
# All modules in this repo store Terraform state in the same GCS bucket
# (created during infra/project bootstrap) with distinct prefixes.
# No separate S3 bucket or DynamoDB lock table required.

bucket = "YOUR_GCS_STATE_BUCKET"   # e.g. agent-tasker-tfstate-lcd
prefix = "agent-aws-nova/dev"
